<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uy.edu.utec.maldonado</groupId>
        <artifactId>ProgApp-grupo8-S4-2026</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>servidor-web</artifactId>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSTL (<c:if>, <c:choose>) para los JSP; Tomcat 10+ usa el namespace jakarta -->
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.web</groupId>
            <artifactId>jakarta.servlet.jsp.jstl</artifactId>
            <version>3.0.1</version>
        </dependency>

        <!-- Bootstrap 5 empaquetado como jar: Tomcat lo sirve en /webjars/bootstrap/5.3.3/... (funciona sin internet) -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>bootstrap</artifactId>
            <version>5.3.3</version>
        </dependency>

        <!-- Cliente JAX-WS para consumir los Web Services del Servidor Central -->
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>jaxws-rt</artifactId>
            <version>4.0.3</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>servidor-web</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- El WSDL viaja dentro del WAR: el cliente no lo pide al central al arrancar -->
            <resource>
                <directory>src/main/wsdl</directory>
                <targetPath>wsdl</targetPath>
            </resource>
        </resources>
        <plugins>
            <!-- Genera el cliente SOAP desde src/main/wsdl (copia del ?wsdl y ?xsd=1 que publica el central).
                 Si cambia el contrato, volver a bajar los dos archivos con el central levantado. -->
            <plugin>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>4.0.3</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                        <configuration>
                            <wsdlDirectory>${project.basedir}/src/main/wsdl</wsdlDirectory>
                            <wsdlFiles>
                                <wsdlFile>ServicioCentral.wsdl</wsdlFile>
                            </wsdlFiles>
                            <packageName>ServidorWeb.ws.central</packageName>
                            <wsdlLocation>/wsdl/ServicioCentral.wsdl</wsdlLocation>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Las imagenes ya no viajan en el WAR: viven en el central, que las siembra desde /imagenes
                 (raiz del repo) al publicar, y el web las pide por SOAP (ImagenesServlet). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>
        </plugins>
    </build>
</project>