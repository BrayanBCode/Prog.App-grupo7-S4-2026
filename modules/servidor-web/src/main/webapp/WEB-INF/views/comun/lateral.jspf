<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%--
  Lateral (letra 7.1, Figuras 2 a 4). De arriba hacia abajo:
    - con sesion: "Mi perfil" y los grupos de casos de uso de su rol (Figura 3: INSCRIPCIONES)
    - USUARIOS: entrada a la Consulta de Usuario
    - INSTITUTOS (las categorias no corresponden al grupo)
    - con sesion: "Salir" (Cierre de Sesion)
  Cada opcion aparece solo si ${puede.XXX} lo permite. Los casos de uso se van sumando
  aca a medida que se rehacen (Fase 4 del plan).
--%>
<nav class="lateral card" aria-label="Menú principal">
    <div class="list-group list-group-flush">
        <c:if test="${rol.autenticado}">
            <c:url var="urlPerfil" value="/usuarios"><c:param name="nick" value="${usuarioActual.nickname}"/></c:url>
            <a class="list-group-item list-group-item-action d-flex justify-content-between fw-semibold" href="${urlPerfil}">
                Mi perfil <span aria-hidden="true">›</span>
            </a>
        </c:if>

        <%-- Docente (como el grupo INSCRIPCIONES de la Figura 3 para el estudiante) --%>
        <c:if test="${puede.ALTA_CURSO}">
            <div class="list-group-item lateral-titulo">Docencia</div>
            <a class="list-group-item list-group-item-action" href="${raiz}/curso/alta">Crear curso</a>
            <a class="list-group-item list-group-item-action" href="${raiz}/docente/cursos">Mis cursos y ediciones</a>
        </c:if>

        <c:if test="${puede.CONSULTA_USUARIO}">
            <div class="list-group-item lateral-titulo">Usuarios</div>
            <a class="list-group-item list-group-item-action" href="${raiz}/usuarios">Ver usuarios</a>
        </c:if>

        <div class="list-group-item lateral-titulo">Institutos</div>
        <%-- Consulta de Curso: cada instituto lleva a sus cursos. Se marca el que se esta viendo. --%>
        <c:forEach var="inst" items="${institutosMenu}">
            <c:url var="uInstituto" value="/cursos"><c:param name="instituto" value="${inst}"/></c:url>
            <c:set var="instActual" value="${inst == instituto or inst == detalle.curso().instituto() or inst == detalleEdicion.instituto()}"/>
            <a class="list-group-item list-group-item-action ${instActual ? 'active' : ''}" href="${uInstituto}"
               ${instActual ? 'aria-current="page"' : ''}><c:out value="${inst}"/></a>
        </c:forEach>

        <c:if test="${puede.CIERRE_SESION}">
            <form method="post" action="${raiz}/logout" class="list-group-item p-0">
                <button type="submit" class="btn btn-link w-100 text-start text-body text-decoration-none px-3 py-2">
                    <span aria-hidden="true">⇥</span> Salir
                </button>
            </form>
        </c:if>
    </div>
</nav>
