<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="e" tagdir="/WEB-INF/tags" %>
<%--
  Cabezal fijo de todas las paginas (letra 7.1, Figuras 2 y 3):
    - izquierda: logo (vuelve al inicio)
    - derecha, Visitante: "Iniciar sesión" | "Registrarse"
    - derecha, con sesion: nombre e imagen reducida del usuario; al hacer clic abre un submenu con
      Mi perfil (Consulta de Usuario), Modo oscuro / Modo claro (js/tema.js) y Cerrar sesion (POST a /logout).
  ${puede.XXX} sale de la matriz CasoDeUso (ver AccesoFilter): aca no se decide por rol.
    - centro: cuadro de busqueda de cursos (requerimiento 7.5), en todas las paginas menos login/registro.
--%>
<c:set var="raiz" value="${pageContext.request.contextPath}"/>

<header class="cabezal border-bottom bg-body sticky-top">
    <div class="container-xl d-flex align-items-center justify-content-between py-2">
        <c:choose>
            <%-- En login/registro no hay links: se vuelve con Cancelar --%>
            <c:when test="${formularioSesion}">
                <span class="logo navbar-brand fw-bold text-primary">edExt</span>
            </c:when>
            <c:otherwise>
                <a class="logo navbar-brand fw-bold text-primary" href="${raiz}/inicio">edExt</a>
            </c:otherwise>
        </c:choose>

        <%-- Busqueda (7.5, Figura 2): sin texto lista todos los cursos --%>
        <c:if test="${puede.BUSCAR_CURSOS_Y_PROGRAMAS and not formularioSesion}">
            <form class="buscador d-flex flex-grow-1 mx-4 gap-2" role="search" action="${raiz}/buscar" method="GET">
                <input class="form-control form-control-sm" type="search" name="q" placeholder="Cursos"
                       aria-label="Buscar cursos" value="<c:out value='${busqueda}'/>">
                <button class="btn btn-outline-secondary btn-sm" type="submit">Buscar</button>
            </form>
        </c:if>

        <nav class="d-flex align-items-center gap-2 ${formularioSesion ? 'd-none' : ''}" aria-label="Sesión">
            <c:if test="${puede.INICIO_SESION}">
                <a href="${raiz}/login">Iniciar sesión</a>
            </c:if>
            <c:if test="${puede.INICIO_SESION and puede.ALTA_USUARIO}">
                <span class="text-body-tertiary" aria-hidden="true">|</span>
            </c:if>
            <c:if test="${puede.ALTA_USUARIO}">
                <a href="${raiz}/registro">Registrarse</a>
            </c:if>

            <c:if test="${rol.autenticado}">
                <c:url var="urlMiPerfil" value="/usuarios"><c:param name="nick" value="${usuarioActual.nickname}"/></c:url>
                <div class="dropdown">
                    <button type="button" class="btn btn-link d-inline-flex align-items-center gap-2 text-body fw-semibold text-decoration-none p-0 dropdown-toggle"
                            data-bs-toggle="dropdown" aria-expanded="false" title="Menú de la cuenta">
                        <c:out value="${usuarioActual.nickname}"/>
                        <e:imagen ruta="${usuarioActual.imagen}" alt="${usuarioActual.nickname}" clase="avatar avatar-mini"/>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" href="${urlMiPerfil}">Mi perfil</a></li>
                        <li><button type="button" class="dropdown-item" data-tema-alternar>Modo oscuro</button></li>
                        <c:if test="${puede.CIERRE_SESION}">
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" action="${raiz}/logout" class="m-0">
                                    <button type="submit" class="dropdown-item">Cerrar sesión</button>
                                </form>
                            </li>
                        </c:if>
                    </ul>
                </div>
            </c:if>
        </nav>
    </div>
</header>
