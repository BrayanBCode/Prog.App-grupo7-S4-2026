<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="e" tagdir="/WEB-INF/tags" %>
<%--
  Cabezal fijo de todas las paginas (letra 7.1, Figuras 2 y 3):
    - izquierda: logo (vuelve al inicio)
    - derecha, Visitante: "Iniciar sesión" | "Registrarse"
    - derecha, con sesion: nombre e imagen reducida del usuario, link a su perfil (Consulta de Usuario).
      "Salir" (Cierre de Sesion) esta al pie del lateral, como en la Figura 3.
  ${puede.XXX} sale de la matriz CasoDeUso (ver AccesoFilter): aca no se decide por rol.
  El cuadro de busqueda de la figura es el requerimiento "Busqueda" (no minimo para el grupo).
--%>
<c:set var="raiz" value="${pageContext.request.contextPath}"/>

<header class="cabezal border-bottom bg-body sticky-top">
    <div class="container-xl d-flex align-items-center justify-content-between py-2">
        <c:choose>
            <%-- En login/registro no hay links: se vuelve con Cancelar --%>
            <c:when test="${formularioSesion}">
                <span class="logo navbar-brand fw-bold text-primary">edExt</span>
            </c:when>
            <c:otherwise>
                <a class="logo navbar-brand fw-bold text-primary" href="${raiz}/inicio">edExt</a>
            </c:otherwise>
        </c:choose>

        <nav class="d-flex align-items-center gap-2 ${formularioSesion ? 'd-none' : ''}" aria-label="Sesión">
            <c:if test="${puede.INICIO_SESION}">
                <a href="${raiz}/login">Iniciar sesión</a>
            </c:if>
            <c:if test="${puede.INICIO_SESION and puede.ALTA_USUARIO}">
                <span class="text-body-tertiary" aria-hidden="true">|</span>
            </c:if>
            <c:if test="${puede.ALTA_USUARIO}">
                <a href="${raiz}/registro">Registrarse</a>
            </c:if>

            <c:if test="${rol.autenticado}">
                <c:url var="urlMiPerfil" value="/usuarios"><c:param name="nick" value="${usuarioActual.nickname}"/></c:url>
                <a class="d-inline-flex align-items-center gap-2 text-body fw-semibold text-decoration-none"
                   href="${urlMiPerfil}" title="Mi perfil">
                    <c:out value="${usuarioActual.nickname}"/>
                    <e:imagen ruta="${usuarioActual.imagen}" alt="${usuarioActual.nickname}" clase="avatar avatar-mini"/>
                </a>
            </c:if>
        </nav>
    </div>
</header>
