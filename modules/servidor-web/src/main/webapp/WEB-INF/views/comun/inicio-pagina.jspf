<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%--
  Marco general de las paginas (letra 7.1, Figura 2): cabezal fijo, lateral con
  el menu e institutos, y la parte central donde se realiza cada caso de uso.
  Uso:  <c:set var="titulo" value="..."/>
        <%@ include file="/WEB-INF/views/comun/inicio-pagina.jspf" %>
        ...contenido...
        <%@ include file="/WEB-INF/views/comun/fin-pagina.jspf" %>
  Formularios de sesion (login, registro): <c:set var="formularioSesion" value="${true}"/> antes del
  include oculta el lateral y los links del cabezal; se sale solo con el boton Cancelar.
--%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${titulo}"/> - edExt</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/webjars/bootstrap/5.3.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css">
</head>
<body class="bg-body-tertiary">
<%@ include file="/WEB-INF/views/comun/cabezal.jspf" %>

<div class="container-xl my-4">
    <div class="row g-4">
        <c:if test="${not formularioSesion}">
            <aside class="col-md-4 col-lg-3">
                <%@ include file="/WEB-INF/views/comun/lateral.jspf" %>
            </aside>
        </c:if>

        <main class="${formularioSesion ? 'col-12' : 'col-md-8 col-lg-9'}">
            <div class="contenido card card-body p-4">
                <c:if test="${not empty flash}">
                    <div class="alert alert-success" role="status"><c:out value="${flash}"/></div>
                </c:if>
                <c:if test="${not empty flashError}">
                    <div class="alert alert-danger" role="alert"><c:out value="${flashError}"/></div>
                </c:if>
                <c:if test="${not empty error}">
                    <div class="alert alert-danger" role="alert"><c:out value="${error}"/></div>
                </c:if>
